digraph adder_sklansky {
  // ────────────────────────────────────────────────────────────────
  // adder_sklansky — Single-phase parallel prefix tree for W=8.
  //
  // Layout: dot (top-down rankdir, level-by-level).
  //
  // At level k, each cell in the right half of each 2^k-wide group
  // merges with the rightmost cell of the left half (the "pivot").
  // Pivot fan-out grows as 2^(k-1): O(log2 W) depth, O(W/2*log2W) cells.
  // Fan-out warning: pivot cell drives up to W/2 cells at last level.
  // ────────────────────────────────────────────────────────────────
  graph [
    rankdir    = TB,
    splines    = spline,
    pad        = 0.4,
    fontname   = "Helvetica",
    nodesep    = 0.5,
    ranksep    = 1.0,
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 11,
    penwidth = 2,
    width    = 0.9,
    height   = 0.65,
    fixedsize = true,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 10,
    penwidth = 1.5,
    color    = "#374151",
  ];

  // Title
  { rank=same;
    title [label="adder_sklansky — Single-Phase Prefix (example: W=8, growing fan-out)",
           shape=plaintext, style="", fontsize=16, fontcolor="#111827",
           width=5, height=0.6, fixedsize=false];
  }
  title -> i0 [style=invis];

  // Input row
  { rank=same;
    i0 [label="g0p0", fillcolor="#bbf7d0", color="#22c55e"];
    i1 [label="g1p1", fillcolor="#bbf7d0", color="#22c55e"];
    i2 [label="g2p2", fillcolor="#bbf7d0", color="#22c55e"];
    i3 [label="g3p3", fillcolor="#bbf7d0", color="#22c55e"];
    i4 [label="g4p4", fillcolor="#bbf7d0", color="#22c55e"];
    i5 [label="g5p5", fillcolor="#bbf7d0", color="#22c55e"];
    i6 [label="g6p6", fillcolor="#bbf7d0", color="#22c55e"];
    i7 [label="g7p7", fillcolor="#bbf7d0", color="#22c55e"];
  }

  // Level 1 (stride 1): pairs {0,1},{2,3},{4,5},{6,7}
  // pivot of each pair = left element; right element merges
  { rank=same;
    ll1 [label="Level 1\nstride 1", shape=plaintext, style="", fontsize=12, fontcolor="#1e3a8a",
         width=1.2, height=0.5, fixedsize=false];
    l1_0 [label="G0",       fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l1_1 [label="G0:1\nP0:1", fillcolor="#bfdbfe", color="#3b82f6"];
    l1_2 [label="G2",       fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l1_3 [label="G2:3\nP2:3", fillcolor="#bfdbfe", color="#3b82f6"];
    l1_4 [label="G4",       fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l1_5 [label="G4:5\nP4:5", fillcolor="#bfdbfe", color="#3b82f6"];
    l1_6 [label="G6",       fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l1_7 [label="G6:7\nP6:7", fillcolor="#bfdbfe", color="#3b82f6"];
  }

  // Level 2 (stride 2): groups {0..3},{4..7}
  // pivot of group {0..3} = bit 1; pivot of {4..7} = bit 5
  { rank=same;
    ll2 [label="Level 2\nstride 2", shape=plaintext, style="", fontsize=12, fontcolor="#1e3a8a",
         width=1.2, height=0.5, fixedsize=false];
    l2_0 [label="G0",       fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l2_1 [label="G0:1",     fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l2_2 [label="G0:2\nP0:2", fillcolor="#bfdbfe", color="#3b82f6"];
    l2_3 [label="G0:3\nP0:3", fillcolor="#bfdbfe", color="#3b82f6"];
    l2_4 [label="G4",       fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l2_5 [label="G4:5",     fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l2_6 [label="G0:6\nP0:6", fillcolor="#bfdbfe", color="#3b82f6"];
    l2_7 [label="G0:7\nP0:7", fillcolor="#bfdbfe", color="#3b82f6"];
  }

  // Level 3 (stride 4): single group {0..7}
  // pivot = bit 3; right half {4..7} merges with bit 3
  { rank=same;
    ll3 [label="Level 3\nstride 4", shape=plaintext, style="", fontsize=12, fontcolor="#1e3a8a",
         width=1.2, height=0.5, fixedsize=false];
    l3_0 [label="G0",       fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l3_1 [label="G0:1",     fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l3_2 [label="G0:2",     fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l3_3 [label="G0:3",     fillcolor="#f5f5f5", color="#9ca3af", style="filled"];
    l3_4 [label="G0:4\nP0:4", fillcolor="#bfdbfe", color="#3b82f6"];
    l3_5 [label="G0:5\nP0:5", fillcolor="#bfdbfe", color="#3b82f6"];
    l3_6 [label="G0:6\nP0:6", fillcolor="#bfdbfe", color="#3b82f6"];
    l3_7 [label="G0:7\nP0:7", fillcolor="#bfdbfe", color="#3b82f6"];
    fanout [label="Pivot fan-out\ngrows as 2^(k-1)\n(wiring cost!)",
            shape=plaintext, style="", fontsize=11, fontcolor="#dc2626",
            width=1.6, height=0.5, fixedsize=false];
  }

  note [label="Depth O(log2 W) = 3  |  Cells (W/2)*log2W = 12  |  Fan-out up to W/2 at last level",
        shape=plaintext, style="", fontsize=12, fontcolor="#374151",
        width=6, height=0.5, fixedsize=false];
  { rank=same; note }
  l3_0 -> note [style=invis];

  // L0 → L1
  i0 -> l1_0; i1 -> l1_1; i0 -> l1_1 [color="#3b82f6"];
  i2 -> l1_2; i3 -> l1_3; i2 -> l1_3 [color="#3b82f6"];
  i4 -> l1_4; i5 -> l1_5; i4 -> l1_5 [color="#3b82f6"];
  i6 -> l1_6; i7 -> l1_7; i6 -> l1_7 [color="#3b82f6"];

  // L1 → L2
  l1_0 -> l2_0; l1_1 -> l2_1;
  l1_2 -> l2_2; l1_1 -> l2_2 [color="#3b82f6"];
  l1_3 -> l2_3; l1_1 -> l2_3 [color="#3b82f6"];
  l1_4 -> l2_4; l1_5 -> l2_5;
  l1_6 -> l2_6; l1_3 -> l2_6 [color="#3b82f6"];
  l1_7 -> l2_7; l1_3 -> l2_7 [color="#3b82f6"];

  // L2 → L3
  l2_0 -> l3_0; l2_1 -> l3_1; l2_2 -> l3_2; l2_3 -> l3_3;
  l2_4 -> l3_4; l2_3 -> l3_4 [color="#3b82f6"];
  l2_5 -> l3_5; l2_3 -> l3_5 [color="#3b82f6"];
  l2_6 -> l3_6; l2_7 -> l3_7;
}
