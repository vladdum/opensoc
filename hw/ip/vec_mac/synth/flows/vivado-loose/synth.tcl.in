# AUTOGENERATED-templated by sweep.mk per cell
read_verilog {
@SOURCES@
}

synth_design -top @TOP@ -part xck26-sfvc784-2LV-c \
  -directive RuntimeOptimized

opt_design
place_design -directive RuntimeOptimized
route_design -directive RuntimeOptimized

report_utilization -file @OUTDIR@/util.rpt
report_timing      -file @OUTDIR@/timing.rpt
report_power       -file @OUTDIR@/power.rpt

# Sanity: count DSP48 cells (must be 0)
set dsp_count [llength [get_cells -hier -filter {PRIMITIVE_GROUP == DSP}]]
puts "DSP_COUNT $dsp_count"
if {$dsp_count != 0} {
  error "DSP48 cells found ($dsp_count); use_dsp=no failed"
}
