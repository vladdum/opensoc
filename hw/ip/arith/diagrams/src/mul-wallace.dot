digraph mul_wallace {
  // ────────────────────────────────────────────────────────────────
  // mul_wallace — Wallace tree multiplier.
  //
  // Layout: dot (hierarchical, top-down).
  //
  // Start with 8 partial-product rows (8×8 signed multiply).
  // Each CSA (carry-save adder) reduces 3 rows → 2 rows.
  // Wallace rule: group into CSA triples greedily at each level.
  // Height sequence (upper bound per column): 8→6→4→3→2 → final add.
  // ────────────────────────────────────────────────────────────────
  graph [
    rankdir  = TB,
    splines  = spline,
    pad      = 0.4,
    fontname = "Helvetica",
    nodesep  = 0.5,
    ranksep  = 1.0,
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 13,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 11,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [label="mul_wallace — Wallace-Tree CSA Reduction (8×8 → 16-bit, 4 levels)",
         shape=plaintext, style="", fontsize=17, fontcolor="#111827"];

  // Inputs
  inp_a [label="a_i [7:0] (signed)", fillcolor="#bbf7d0", color="#22c55e"];
  inp_b [label="b_i [7:0] (signed)", fillcolor="#bbf7d0", color="#22c55e"];

  // Partial products
  subgraph cluster_pp {
    label="8 Partial Products  (sign-extended rows)";
    style="filled,rounded";
    fillcolor="#eff6ff";
    color="#3b82f6";
    penwidth=2;
    fontsize=12;
    fontname="Helvetica";

    pp [label="PP[0]  PP[1]  PP[2]  PP[3]\nPP[4]  PP[5]  PP[6]  PP[7]",
        fillcolor="#bbf7d0", color="#22c55e", fontsize=13];
  }

  // Level 1: 8 → 6  (two independent CSA triples)
  subgraph cluster_l1 {
    label="Level 1 — two CSA triples  8→6";
    style="filled,rounded";
    fillcolor="#eff6ff";
    color="#3b82f6";
    penwidth=2;
    fontsize=12;
    fontname="Helvetica";

    l1a [label="CSA_A(PP[0],PP[1],PP[2])\n→ s_a, c_a", fillcolor="#bfdbfe", color="#3b82f6", fontsize=12];
    l1b [label="CSA_B(PP[3],PP[4],PP[5])\n→ s_b, c_b", fillcolor="#bfdbfe", color="#3b82f6", fontsize=12];
    l1p [label="PP[6], PP[7] pass through", fillcolor="#f5f5f5", color="#9ca3af", fontsize=12];
  }

  // Level 2: 6 → 4  (two CSA triples)
  subgraph cluster_l2 {
    label="Level 2 — two CSAs  6→4";
    style="filled,rounded";
    fillcolor="#eff6ff";
    color="#3b82f6";
    penwidth=2;
    fontsize=12;
    fontname="Helvetica";

    l2a [label="CSA_C(s_a, c_a, s_b)\n→ s_c, c_c", fillcolor="#bfdbfe", color="#3b82f6", fontsize=12];
    l2b [label="CSA_D(c_b, PP[6], PP[7])\n→ s_d, c_d", fillcolor="#bfdbfe", color="#3b82f6", fontsize=12];
  }

  // Level 3: 4 → 3
  subgraph cluster_l3 {
    label="Level 3 — one CSA  4→3";
    style="filled,rounded";
    fillcolor="#eff6ff";
    color="#3b82f6";
    penwidth=2;
    fontsize=12;
    fontname="Helvetica";

    l3  [label="CSA_E(s_c, c_c, s_d)\n→ s_e, c_e", fillcolor="#bfdbfe", color="#3b82f6", fontsize=12];
    l3p [label="c_d passes through", fillcolor="#f5f5f5", color="#9ca3af", fontsize=12];
  }

  // Level 4: 3 → 2
  subgraph cluster_l4 {
    label="Level 4 — one CSA  3→2";
    style="filled,rounded";
    fillcolor="#eff6ff";
    color="#3b82f6";
    penwidth=2;
    fontsize=12;
    fontname="Helvetica";

    l4 [label="CSA_F(s_e, c_e, c_d)\n→ S_final, C_final", fillcolor="#bfdbfe", color="#3b82f6", fontsize=12];
  }

  // Final adder + output
  fadd [label="Final Adder\nS_final + C_final → product",
        fillcolor="#fca5a5", color="#ef4444", fontsize=13];
  outp [label="p_o [15:0]", fillcolor="#fca5a5", color="#ef4444", fontsize=14];

  note [label="Wallace: greedy grouping maximizes CSA parallelism. Depth: O(log₁.₅ B_W).\nSame final structure as Dadda but typically more CSAs at early levels.",
        shape=plaintext, style="", fontsize=12, fontcolor="#374151"];

  // Edges
  inp_a -> pp; inp_b -> pp;
  pp -> l1a; pp -> l1b; pp -> l1p;
  l1a -> l2a; l1b -> l2a;
  l1b -> l2b; l1p -> l2b;
  l2a -> l3; l2b -> l3;
  l2b -> l3p;
  l3 -> l4; l3p -> l4;
  l4 -> fadd;
  fadd -> outp;
}
